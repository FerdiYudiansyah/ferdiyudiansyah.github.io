---
// Section 1 — Motto + Name
---

<section id="motto" class="relative min-h-screen flex items-center overflow-hidden">
  <div class="w-full max-w-6xl mx-auto px-6 md:pr-28 md:pl-10 pt-5 pb-16 grid md:grid-cols-[1.2fr_0.8fr] gap-12 items-center">
    <div>
      <h1 class="mb-2 font-display font-bold leading-[0.95] text-5xl md:text-7xl lg:text-8xl">
        <span class="block text-white text-glow">PORTOFOLIO</span>
      </h1>

      <hr/>

      <div class="mt-10 inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass text-[11px] tracking-[0.25em] font-semibold text-cyan-300">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        MISSION LOG // 001 — MOTTO
      </div>

      <p class="mt-8 font-display text-lg md:text-xl text-slate-400 italic">
        “Reach for the stars, build beyond limits.”
      </p>

      <h1 class="mt-4 font-display font-bold leading-[0.95] text-5xl md:text-7xl lg:text-8xl">
        <span class="block text-white text-glow">FERDI</span>
        <span class="block bg-gradient-to-r from-violet-400 via-fuchsia-300 to-cyan-300 bg-clip-text text-transparent">YUDIANSYAH</span>
      </h1>

      <p class="mt-6 max-w-xl text-slate-400 leading-relaxed">
        Software engineer navigating the universe of code — crafting digital worlds
        one orbit at a time. Welcome aboard my portfolio station.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#projects" class="px-6 py-3 rounded-xl font-semibold text-sm bg-gradient-to-r from-violet-600 to-cyan-500 text-white shadow-lg shadow-violet-600/40 hover:shadow-cyan-500/30 hover:scale-[1.02] active:scale-95 transition">
          View Projects
        </a>
        <a href="#hello" class="px-6 py-3 rounded-xl font-semibold text-sm glass text-slate-200 hover:bg-white/10 hover:scale-[1.02] active:scale-95 transition">
          Explore
        </a>
      </div>

      <div class="mt-10 flex items-center gap-6 text-xs text-slate-500 font-mono">
        <span>RA 18h 36m · DEC −38°</span>
        <span class="hidden sm:inline">VELOCITY: 7.8 KM/S</span>
        <span class="hidden sm:inline text-emerald-400">● SYSTEMS NOMINAL</span>
      </div>
    </div>

    <!-- Planet visual -->
    <div class="relative hidden md:flex items-center justify-center h-[420px] translate-x-20">
      <div class="absolute w-72 h-72 rounded-full bg-[radial-gradient(circle_at_30%_30%,#c4b5fd,#7c3aed_35%,#2e1065_65%,#030014_100%)] shadow-[0_0_80px_rgba(124,58,237,0.6)] animate-[float_8s_ease-in-out_infinite]"></div>
      <div class="absolute w-[26rem] h-[7rem] rounded-[100%] saturn-ring rotate-[-18deg] backdrop-blur-[1px]"></div>
      <div class="absolute w-[26rem] h-[7rem] rounded-[100%] border border-white/10 rotate-[-18deg] scale-110"></div>
      <!-- orbiting moon -->
      <div class="absolute w-full h-full animate-[spin_24s_linear_infinite]">
        <div class="absolute top-8 left-1/2 w-5 h-5 rounded-full bg-gradient-to-br from-cyan-200 to-cyan-600 shadow-[0_0_20px_rgba(34,211,238,0.8)]" style="animation: orbit 0s;"></div>
      </div>
      <!-- floating chips -->
      <div class="absolute top-6 right-2 px-3 py-2 rounded-xl glass text-xs font-mono text-cyan-200 animate-[float_6s_ease-in-out_infinite]">◈ clean code</div>
      <div class="absolute bottom-10 left-0 px-3 py-2 rounded-xl glass text-xs font-mono text-violet-200 animate-[float_7s_ease-in-out_infinite]">✦ astro + tailwind</div>
    </div>
  </div>

  <!-- scroll hint -->
  <a href="#hello" class="absolute bottom-8 left-1/2 -translate-x-1/2 md:-ml-12 flex flex-col items-center gap-2 text-slate-500 hover:text-slate-300 transition text-[11px] tracking-widest">
    <span>SCROLL TO EXPLORE</span>
    <span class="w-6 h-10 rounded-full border border-white/20 flex justify-center pt-2">
      <span class="w-1 h-2 rounded-full bg-cyan-300 animate-bounce"></span>
    </span>
  </a>
</section>
