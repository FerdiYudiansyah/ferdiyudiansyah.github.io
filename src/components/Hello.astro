---
// Section 2 — Hello, my name is...
---

<section id="hello" class="relative min-h-screen flex items-center">
  <div class="w-full max-w-6xl mx-auto px-6 md:pr-28 md:pl-10 py-24 grid md:grid-cols-[0.9fr_1.1fr] gap-12 items-center">
    <!-- Avatar / planet card -->
    <div class="relative mx-auto w-64 h-64 md:w-80 md:h-80">
      <div class="absolute inset-0 rounded-full bg-gradient-to-br from-violet-600/30 to-cyan-400/20 blur-2xl"></div>
      <div class="relative w-full h-full rounded-full glass flex items-center justify-center overflow-hidden">
        <div class="absolute inset-4 rounded-full bg-[radial-gradient(circle_at_35%_30%,#1e1b4b,#030014_70%)]"></div>
        <span class="relative font-display font-bold text-7xl md:text-8xl bg-gradient-to-br from-white to-slate-400 bg-clip-text text-transparent">FY</span>
        <!-- orbit ring -->
        <div class="absolute inset-0 rounded-full border border-dashed border-cyan-300/30 animate-[spin_24s_linear_infinite]"></div>
        <div class="absolute top-4 right-10 w-3 h-3 rounded-full bg-cyan-300 shadow-[0_0_12px_rgba(34,211,238,1)]"></div>
      </div>
      <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-xs font-semibold whitespace-nowrap">
        ● Open to opportunities
      </div>
    </div>

    <div>
      <p class="text-xs tracking-[0.3em] font-semibold text-cyan-300">TRANSMISSION // 002 — GREETING</p>
      <h2 class="mt-4 font-display font-bold text-4xl md:text-6xl text-white leading-tight">
        Hello<span class="text-cyan-300">,</span> my name is<br />
        <span class="bg-gradient-to-r from-violet-300 to-cyan-300 bg-clip-text text-transparent">Ferdi Yudiansyah</span>
      </h2>
      <p class="mt-3 font-display text-lg text-slate-400">
        I'm a <span id="rotatingRole" class="text-white font-semibold">Software Engineer</span><span class="text-cyan-300 animate-pulse">|</span>
      </p>
      <p class="mt-5 text-slate-400 leading-relaxed max-w-xl">
        I turn ideas into fast, beautiful web experiences. Currently orbiting around
        modern web tech — Astro, Tailwind CSS, JavaScript/TypeScript — and always
        learning a new constellation of tools.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://github.com/ferdiyudiansyah" target="_blank" rel="noreferrer" class="px-6 py-3 rounded-xl text-sm font-semibold bg-white text-slate-950 hover:bg-cyan-100 hover:scale-[1.02] active:scale-95 transition flex items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 015.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .3.2.67.8.55A11.51 11.51 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          Visit GitHub
        </a>
        <a href="#about" class="px-6 py-3 rounded-xl text-sm font-semibold glass text-slate-200 hover:bg-white/10 transition">More about me ↓</a>
      </div>
    </div>
  </div>
</section>

<script>
  const roles = ['Software Engineer', 'Frontend Developer', 'Astro Explorer', 'Problem Solver', 'Designer', 'Game Developer'];
  const el = document.getElementById('rotatingRole');
  let i = 0;
  if (el) {
    setInterval(() => {
      i = (i + 1) % roles.length;
      el.style.opacity = '0';
      setTimeout(() => {
        el.textContent = roles[i];
        el.style.opacity = '1';
      }, 250);
    }, 2200);
    el.style.transition = 'opacity 0.25s ease';
  }
</script>
