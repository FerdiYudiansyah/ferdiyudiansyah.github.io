---
// Fixed space backdrop: gradient void + nebulas + twinkling star canvas + shooting stars
---

<div class="fixed inset-0 -z-10 overflow-hidden bg-[#030014]" aria-hidden="true">
  <!-- Nebula glows -->
  <div class="absolute -top-40 -left-40 w-[36rem] h-[36rem] rounded-full bg-violet-700/25 blur-[140px]"></div>
  <div class="absolute top-1/3 -right-48 w-[32rem] h-[32rem] rounded-full bg-cyan-500/15 blur-[140px]"></div>
  <div class="absolute bottom-0 left-1/3 w-[28rem] h-[28rem] rounded-full bg-fuchsia-600/15 blur-[140px]"></div>
  <!-- Tiny distant planet -->
  <div class="absolute top-16 left-[5%] w-20 h-20 rounded-full bg-gradient-to-br from-violet-400 via-fuchsia-500 to-indigo-900 shadow-[0_0_60px_rgba(167,139,250,0.5)] opacity-80 hidden md:block"></div>
  <canvas id="stars" class="absolute inset-0 w-full h-full"></canvas>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(3,0,20,0.6)_75%,#030014_100%)]"></div>
</div>

<script>
  const canvas = document.getElementById('stars');
  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    let stars = [];
    let shootings = [];
    let w = 0, h = 0;

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
      stars = Array.from({ length: Math.min(260, Math.floor((w * h) / 6500)) }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.6 + 0.3,
        p: Math.random() * Math.PI * 2,
        s: 0.008 + Math.random() * 0.03,
      }));
    }
    resize();
    window.addEventListener('resize', resize);

    function spawnShooting() {
      shootings.push({
        x: Math.random() * w * 0.7 + w * 0.15,
        y: Math.random() * h * 0.3,
        vx: -(6 + Math.random() * 4),
        vy: 3 + Math.random() * 2,
        life: 1,
      });
      setTimeout(spawnShooting, 3500 + Math.random() * 5000);
    }
    setTimeout(spawnShooting, 2000);

    function tick() {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      // stars
      for (const st of stars) {
        st.p += st.s;
        const a = 0.25 + Math.abs(Math.sin(st.p)) * 0.75;
        ctx.beginPath();
        ctx.globalAlpha = a;
        ctx.fillStyle = '#ffffff';
        ctx.arc(st.x, st.y, st.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      // shooting stars
      shootings = shootings.filter((s) => s.life > 0);
      for (const s of shootings) {
        s.x += s.vx; s.y += s.vy; s.life -= 0.015;
        const grad = ctx.createLinearGradient(s.x, s.y, s.x + 70, s.y - 35);
        grad.addColorStop(0, `rgba(255,255,255,${Math.max(s.life, 0)})`);
        grad.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(s.x, s.y);
        ctx.lineTo(s.x + 70, s.y - 35);
        ctx.stroke();
      }
      requestAnimationFrame(tick);
    }
    tick();
  }
</script>
