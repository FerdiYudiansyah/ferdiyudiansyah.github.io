---
// Floating right navbar (desktop) + floating bottom dock (mobile)
// Sections: motto, hello, about, expertise, projects
const links = [
  {
    id: 'motto',
    label: 'Motto',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v2m0 14v2m9-9h-2M5 12H3m14.5-6.5l-1.4 1.4M7.9 16.1l-1.4 1.4m11.4 0l-1.4-1.4M7.9 7.9L6.5 6.5M16 12a4 4 0 11-8 0 4 4 0 018 0z" />',
  },
  {
    id: 'hello',
    label: 'Hello',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 11V7a5 5 0 0110 0v4m-10 0a2 2 0 00-2 2v3a2 2 0 002 2h1v-7H7zm10 0v7h1a2 2 0 002-2v-3a2 2 0 00-2-2h-1zM7 18v2m10-2v2" />',
  },
  {
    id: 'about',
    label: 'About',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />',
  },
  {
    id: 'expertise',
    label: 'Skills',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 8l-4 4 4 4" />',
  },
  {
    id: 'projects',
    label: 'Projects',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />',
  },
];
---

<!-- Desktop: floating right rail -->
<nav
  id="sideNav"
  class="hidden md:flex fixed right-20 top-1/2 -translate-y-1/2 z-50 flex-col items-center gap-2 p-3 rounded-3xl glass shadow-[0_0_40px_rgba(124,58,237,0.25)]"
  aria-label="Primary"
>
  <a href="#motto" class="mb-2 w-11 h-11 rounded-2xl flex items-center justify-center font-display font-bold text-sm bg-gradient-to-br from-violet-600 to-cyan-400 text-white shadow-lg shadow-violet-600/40" title="Ferdi Yudiansyah — Home">FY</a>
  <div class="w-8 h-px bg-white/10"></div>
  {links.map((l) => (
    <a
      href={`#${l.id}`}
      data-nav={l.id}
      class="nav-dot group relative w-11 h-11 rounded-2xl flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 transition-all duration-300"
      aria-label={l.label}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={l.icon} />
      <span class="pointer-events-none absolute right-[calc(100%+14px)] top-1/2 -translate-y-1/2 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-900/95 border border-white/10 text-white opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 shadow-xl">
        {l.label}
      </span>
    </a>
  ))}
  <div class="w-8 h-px bg-white/10 mt-1"></div>
  <a href="https://github.com/ferdiyudiansyah" target="_blank" rel="noreferrer" class="w-11 h-11 rounded-2xl flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 transition" aria-label="GitHub" title="GitHub">
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 015.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .3.2.67.8.55A11.51 11.51 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
  </a>
</nav>

<!-- Mobile: floating bottom dock -->
<nav
  id="mobileNav"
  class="md:hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-1 p-2 rounded-2xl glass shadow-[0_0_30px_rgba(124,58,237,0.35)]"
  aria-label="Primary mobile"
>
  {links.map((l) => (
    <a
      href={`#${l.id}`}
      data-nav={l.id}
      class="nav-dot w-11 h-11 rounded-xl flex items-center justify-center text-slate-400 transition"
      aria-label={l.label}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={l.icon} />
    </a>
  ))}
</nav>

<script>
  const dots = document.querySelectorAll('.nav-dot');
  const sections = ['motto', 'hello', 'about', 'expertise', 'projects']
    .map((id) => document.getElementById(id))
    .filter(Boolean);

  const activeClasses = ['bg-gradient-to-br', 'from-violet-600', 'to-cyan-500', 'text-white', 'shadow-lg', 'shadow-violet-600/40', 'scale-105'];

  function setActive(id) {
    dots.forEach((d) => {
      const isActive = d.getAttribute('data-nav') === id;
      // remove from all first
      d.classList.remove(...activeClasses);
      if (isActive) d.classList.add(...activeClasses);
    });
  }

  if ('IntersectionObserver' in window && sections.length) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(e.target.id);
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );
    sections.forEach((s) => s && obs.observe(s));
  }

  // Smooth offset scroll (accounts for nothing fixed on top, but keeps niceness)
  dots.forEach((d) => {
    d.addEventListener('click', (ev) => {
      const id = d.getAttribute('data-nav');
      const el = id && document.getElementById(id);
      if (!el) return;
      ev.preventDefault();
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', `#${id}`);
    });
  });
</script>

<style>
  .nav-dot.bg-gradient-to-br {
    color: white !important;
  }
</style>
